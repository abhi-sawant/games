{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    },
    {
      "name": "mp-worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../GamesPlatform/api",
        "run",
        "dev",
        "--",
        "--port",
        "8787",
        "--var",
        "ALLOWED_ORIGINS:http://localhost:5175"
      ],
      "port": 8787
    },
    {
      "name": "dev-online",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "mponline",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    }
  ]
}
